{
  "name": "gannet",
  "private": true,
  "version": "0.1.0",
  "description": "A fast, keyboard-first issue tracker that uses Jira as its backend. Ships as a Chrome extension.",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && node scripts/check-build.mjs",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "icons": "node scripts/make-icons.mjs",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@tanstack/react-virtual": "3.14.26",
    "idb-keyval": "6.3.0",
    "lucide-react": "0.577.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "zustand": "5.1.0"
  },
  "devDependencies": {
    "@types/chrome": "0.1.43",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "jsdom": "26.1.0",
    "typescript": "5.9.3",
    "vite": "7.3.8",
    "vitest": "3.2.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/codythatsme/gannet.git"
  }
}
